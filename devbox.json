{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.0/.schema/devbox.schema.json",
  "packages": [
    "dotnet-sdk_10@latest",
    "nodejs_24@latest"
  ],
  "shell": {
    "init_hook": [
      "if ! command -v claude &>/dev/null; then npm install -g @anthropic-ai/claude-code; fi"
    ],
    "scripts": {
      "start": "dotnet watch run --project ./template/src/Tusk.Api/Tusk.Api.csproj",
      "test": "dotnet test ./template/",
      "claude": "claude"
    }
  }
}
